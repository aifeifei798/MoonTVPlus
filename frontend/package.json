{
  "name": "moontvplus-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "gen:manifest": "node scripts/generate-manifest.mjs",
    "build": "pnpm gen:manifest && vite build && tailwindcss -i ./src/app/globals.css -o ./dist/assets/tailwind.css --minify && node scripts/postbuild.mjs",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource/inter": "^5.1.0",
    "@types/crypto-js": "^4.2.2",
    "artplayer": "5.3.0",
    "artplayer-plugin-danmuku": "5.3.0",
    "crypto-js": "^4.2.0",
    "he": "^1.2.0",
    "hls.js": "^1.5.17",
    "lucide-react": "^0.469.0",
    "next-themes": "^0.4.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "sweetalert2": "^11.14.0"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.9",
    "@types/he": "^1.2.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "vite": "^6.0.0"
  }
}
