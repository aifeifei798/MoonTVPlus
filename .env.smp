# MoonTVPlus — example env file. Copy it, set PASSWORD, done.
#
# server.sh loads ./.env automatically, before start/restart/run/cron. It is
# parsed dotenv-style, not sourced, so the file cannot run anything. The rules
# below are what the parser actually does:
#
#   * KEY=value. A line without `=` is skipped.
#   * whole-line `#` comments only — there are NO inline comments.
#     `PASSWORD=abc  # x` sets PASSWORD to "abc  # x".
#   * do not indent an assignment. `  KEY=value` fails the key pattern and is
#     skipped silently, which looks like a working file that does nothing.
#   * values are NOT trimmed. A trailing space in `PASSWORD=abc ` breaks login,
#     and neither the file nor the browser shows it.
#   * surrounding single or double quotes are stripped; spaces inside survive.
#   * an `export ` prefix is accepted. `KEY=` with nothing after it sets an
#     empty value, and empty is falsy to the app, so it also clears a value you
#     exported in the shell.
#   * later lines win over earlier ones, and the file wins over the shell
#     environment. Only --host/--port beat the file.
#
# The names are upstream MoonTV's, kept identical so existing `docker run -e`
# flags and docker-compose `environment:` blocks work unchanged. That includes
# the inconsistency: PASSWORD and USERNAME are NOT NEXT_PUBLIC_-prefixed.
#
# Deliberately ignored by this port, so leaving them in an old deployment is
# harmless: DOCKER_ENV, SITE_NAME (non-prefixed), UPSTASH_URL, UPSTASH_TOKEN.

# --- required ---------------------------------------------------------------
# PASSWORD unset means the auth gate 307s every page to /warning.
PASSWORD=moontv-plus-dev-password
# USERNAME is the owner/admin user: the one who can reach /api/admin/* and the
# one whose password must equal PASSWORD to log in.
USERNAME=admin

# --- storage ----------------------------------------------------------------
# sqlite is the only backend ported so far. The old `localstorage` and `d1`
# values are accepted and collapse onto the same sqlite store.
NEXT_PUBLIC_STORAGE_TYPE=sqlite
# MOONTV_DB_PATH is already defaulted by server.sh to an absolute path
# (backend/moontv.db), so leave it commented unless you want another location.
#MOONTV_DB_PATH=/var/lib/moontvplus/moontv.db
# Use an absolute path here: a relative one is resolved against the process's
# cwd, not against the repo, so it moves with `cd`.
#MOONTV_CONFIG_PATH=/home/feifei/develop/MoonTVPlus/backend/config.json

# --- appearance -------------------------------------------------------------
NEXT_PUBLIC_SITE_NAME=MoonTVPlus
# Banner shown in the navigation. The built-in default is Chinese; uncomment to
# replace it with your own text.
#ANNOUNCEMENT=This site only indexes information; nothing is hosted here.

# --- search -----------------------------------------------------------------
# How many downstream pages one search walks. Numbers as text; 0 and anything
# that is not a number fall back to the default, like `Number(x) || default`.
NEXT_PUBLIC_SEARCH_MAX_PAGE=5

# --- switches ---------------------------------------------------------------
# Booleans are strict string equality: only the exact word true is truthy.
# `1`, `TRUE` and `yes` all mean false.
NEXT_PUBLIC_ENABLE_REGISTER=false
NEXT_PUBLIC_DISABLE_YELLOW_FILTER=false

# --- optional ---------------------------------------------------------------
#NEXT_PUBLIC_DANMU_API_BASE_URL=
#NEXT_PUBLIC_PLAYBACK_SAVE_INTERVAL=5
#NEXT_PUBLIC_DOUBAN_PROXY_TYPE=direct
#NEXT_PUBLIC_DOUBAN_PROXY=
#NEXT_PUBLIC_DOUBAN_IMAGE_PROXY_TYPE=direct
#NEXT_PUBLIC_DOUBAN_IMAGE_PROXY=
#TVBOX_ENABLED=true
#M3U8_PROXY_ALLOW_HOSTS=

# --- bind address (server.sh flags win over these) --------------------------
# HOSTNAME is the name the old MoonTV Docker image exported; HOST is the one
# server.sh reads. Either works from this file; --host/--port beat both.
#HOST=0.0.0.0
#PORT=3000

# --- server.sh knobs, MOONTVPLUS_ prefix (the app never reads these) --------
# Set these on the command line, not here: MOONTVPLUS_ENV_FILE is read before
# this file is parsed, so a value in the file it names has no effect.
#MOONTVPLUS_RELOAD=1
#MOONTVPLUS_LOG_LEVEL=debug
#MOONTVPLUS_RUN_DIR=/tmp/moontvplus-run
#MOONTVPLUS_DATA_DIR=/var/lib/moontvplus
#MOONTVPLUS_STOP_TIMEOUT=10
#MOONTVPLUS_CRON_INTERVAL=3600
